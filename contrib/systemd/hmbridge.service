[Unit]
Description=hmbridge: HomeMatic BidCoS thermostats to Home Assistant (MQTT)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/hmbridge -config /etc/hmbridge/config.json
Restart=always
RestartSec=5
# hmbridge exits when the radio module resets or the serial link fails;
# systemd restarts it, which re-initialises the module.
User=hmbridge
Group=hmbridge
SupplementaryGroups=dialout gpio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/hmbridge
# Sandbox. hmbridge needs no capabilities: the radio module's UART, the
# GPIO reset line (/dev/gpiochip0, character device ioctls) and OpenCCU's
# raw-uart reset ioctl are reached through device permissions (groups
# dialout, gpio), and it only reads the clock's sync state (adjtimex
# without changes).
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
DevicePolicy=closed
# /dev/serial0 is a symlink to ttyAMA0 or ttyS0 (mini UART), depending
# on the Pi and dtoverlay=disable-bt; missing devices are skipped.
DeviceAllow=/dev/serial0 rw
DeviceAllow=/dev/ttyAMA0 rw
DeviceAllow=/dev/ttyS0 rw
DeviceAllow=/dev/raw-uart rw
DeviceAllow=/dev/gpiochip0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# adjtimex is in @clock, not in @system-service; hmbridge only reads
# with it (is the clock NTP-synchronised?). Setting the clock stays
# impossible without CAP_SYS_TIME.
SystemCallFilter=@system-service adjtimex
SystemCallErrorNumber=EPERM
UMask=0077
LimitCORE=0
# state_dir (default /var/lib/hmbridge): the paired devices and the last
# known device state. systemd creates it, owned by hmbridge and private.
StateDirectory=hmbridge
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
